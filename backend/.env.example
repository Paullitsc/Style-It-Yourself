# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Google Gemini API (for Nano Banana Pro)
GEMINI_API_KEY=your-gemini-api-key

# CORS (comma-separated origins)
# Production: https://styleityourself.ca,https://www.styleityourself.ca
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Extra allowed origins as a regex — lets the Chrome extension
# (origin chrome-extension://<id>) call the API. Defaults to any extension;
# pin to a specific ID in production, e.g. chrome-extension://abcdefghijklmno
CORS_ORIGIN_REGEX=chrome-extension://.*

# Rate limiting
# Counters are shared across instances via the consume_rate_limit RPC in
# supabase_schema.sql; apply that schema before deploying (see DEPLOYMENT.md).
# Set false only to disable limiting entirely (tests, local debugging).
RATE_LIMIT_ENABLED=true

# Per-IP ceiling per 60s, enforced before authentication. Per-instance, so the
# real ceiling is this x the instance count.
RATE_LIMIT_IP_PER_MINUTE=100

# Read the client IP from the left-most X-Forwarded-For entry. Required behind
# Cloud Run, where the socket peer is a shared Google frontend. Set false only
# when the API is exposed directly to clients with no proxy in front.
RATE_LIMIT_TRUST_FORWARDED_FOR=true

# Logging
# Both default per environment, so leave them unset unless overriding:
#   LOG_LEVEL   DEBUG in development, INFO in production
#   LOG_FORMAT  console in development, json in production
# json is what Cloud Logging parses (it reads the severity and message keys);
# console is the readable one for a terminal.
# LOG_LEVEL=INFO
# LOG_FORMAT=console

# Error tracking (Sentry). Unset means disabled: no DSN, no reporting, no
# network calls. Create a free project at sentry.io and paste its DSN to turn
# it on in production.
SENTRY_DSN=

# Fraction of requests traced for performance monitoring, 0.0 to 1.0. Leave at
# 0 for errors only, which is what the free tier affords. Raising it also
# starts recording spans around the Gemini calls.
SENTRY_TRACES_SAMPLE_RATE=0.0

# Environment
ENVIRONMENT=development
DEBUG=true

