{
  "manifest_version": 3,
  "name": "Style It Yourself",
  "version": "0.1.0",
  "description": "Capture products from any store and add them to — or match them against — your Style It Yourself closet.",
  "action": {
    "default_title": "Style It Yourself",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8000/*", "https://api.styleityourself.ca/*"],
  "externally_connectable": {
    "matches": ["http://localhost:3000/*", "https://styleityourself.ca/*", "https://www.styleityourself.ca/*"]
  }
}
